{"content":"#!/usr/bin/env python3\n\"\"\"\nCertificate verification script.\nVerifies that the certificate exists and can be loaded.\n\"\"\"\n\nimport os\nfrom datetime import datetime\nfrom cryptography import x509\nfrom cryptography.hazmat.backends import default_backend\n\n\ndef load_certificate(cert_path):\n    \"\"\"Load and return the certificate from the given path.\"\"\"\n    with open(cert_path, 'rb') as f:\n        cert_data = f.read()\n    return x509.load_pem_x509_certificate(cert_data, default_backend())\n\n\ndef get_common_name(cert):\n    \"\"\"Extract and return the Common Name from the certificate.\"\"\"\n    try:\n        cn_attributes = cert.subject.get_attributes_for_oid(x509.oid.NameOID.COMMON_NAME)\n        if cn_attributes:\n            return cn_attributes[0].value\n    except Exception:\n        pass\n    return \"N/A\"\n\n\ndef format_date(date_obj):\n    \"\"\"Format a datetime object as YYYY-MM-DD.\"\"\"\n    return date_obj.strftime('%Y-%m-%d')\n\n\ndef main():\n    cert_path = '/app/ssl/server.crt'\n    \n    try:\n        # Check if certificate file exists\n        if not os.path.exists(cert_path):\n            print(f\"Error: Certificate file not found at {cert_path}\")\n            return\n        \n        # Load the certificate\n        cert = load_certificate(cert_path)\n        \n        # Get certificate details\n        subject = cert.subject\n        common_name = get_common_name(cert)\n        expiration_date = cert.not_valid_after_utc\n        formatted_expiration = format_date(expiration_date)\n        \n        # Print certificate details\n        print(f\"Certificate Details:\")\n        print(f\"  Common Name (CN): {common_name}\")\n        print(f\"  Organization (O): {subject}\")\n        print(f\"  Expiration Date: {formatted_expiration}\")\n        \n        # Verify the certificate is not expired\n        current_date = datetime.now(expiration_date.tzinfo)\n        if current_date > expiration_date:\n            print(\"Error: Certificate has expired!\")\n            return\n        \n        print(\"Certificate verification successful\")\n        \n    except FileNotFoundError:\n        print(f\"Error: Certificate file not found at {cert_path}\")\n    except Exception as e:\n        print(f\"Error loading certificate: {e}\")\n\n\nif __name__ == '__main__':\n    main()\n","filePath":"/app/check_cert.py"}