{"content":"const fs = require('fs');\n\nfunction extractMemoryValues(filePath) {\n    const buffer = fs.readFileSync(filePath);\n    const memory = {};\n    \n    // Parse ELF header\n    const e_entry = buffer.readUInt32LE(0x18) | (buffer.readUInt32LE(0x1c) << 32);\n    const e_phoff = buffer.readUInt32LE(0x20) | (buffer.readUInt32LE(0x24) << 32);\n    const e_shoff = buffer.readUInt32LE(0x28) | (buffer.readUInt32LE(0x2c) << 32);\n    const e_phentsize = buffer.readUInt16LE(0x36);\n    const e_phnum = buffer.readUInt16LE(0x38);\n    const e_shentsize = buffer.readUInt16LE(0x3a);\n    const e_shnum = buffer.readUInt16LE(0x3c);\n    const e_shstrndx = buffer.readUInt16LE(0x3e);\n    \n    // Parse section headers\n    const sections = [];\n    for (let i = 0; i < e_shnum; i++) {\n        const offset = e_shoff + i * e_shentsize;\n        const sh_name = buffer.readUInt32LE(offset);\n        const sh_type = buffer.readUInt32LE(offset + 4);\n        const sh_flags = buffer.readUInt64LE ? buffer.readUInt64LE(offset + 8) : \n                         (buffer.readUInt32LE(offset + 12) << 32 | buffer.readUInt32LE(offset + 8));\n        const sh_addr = buffer.readUInt64LE ? buffer.readUInt64LE(offset + 16) : \n                        (buffer.readUInt32LE(offset + 20) << 32 | buffer.readUInt32LE(offset + 16));\n        const sh_offset = buffer.readUInt64LE ? buffer.readUInt64LE(offset + 24) : \n                          (buffer.readUInt32LE(offset + 28) << 32 | buffer.readUInt32LE(offset + 24));\n        const sh_size = buffer.readUInt64LE ? buffer.readUInt64LE(offset + 32) : \n                        (buffer.readUInt32LE(offset + 36) << 32 | buffer.readUInt32LE(offset + 32));\n        const sh_link = buffer.readUInt32LE(offset + 40);\n        const sh_info = buffer.readUInt32LE(offset + 44);\n        const sh_addralign = buffer.readUInt64LE ? buffer.readUInt64LE(offset + 48) : \n                             (buffer.readUInt32LE(offset + 52) << 32 | buffer.readUInt32LE(offset + 48));\n        const sh_entsize = buffer.readUInt64LE ? buffer.readUInt64LE(offset + 56) : \n                           (buffer.readUInt32LE(offset + 60) << 32 | buffer.readUInt32LE(offset + 56));\n        \n        sections.push({\n            name: sh_name,\n            type: sh_type,\n            addr: sh_addr,\n            offset: sh_offset,\n            size: sh_size,\n            link: sh_link\n        });\n    }\n    \n    // Get section name string table\n    const shstrtab = sections[e_shstrndx];\n    const sectionNames = [];\n    let nameOffset = shstrtab.offset;\n    let currentName = \"\";\n    for (let i = 0; i < buffer.length; i++) {\n        if (i >= shstrtab.offset && i < shstrtab.offset + shstrtab.size) {\n            if (buffer[i] === 0) {\n                sectionNames.push(currentName);\n                currentName = \"\";\n            } else {\n                currentName += String.fromCharCode(buffer[i]);\n            }\n        }\n    }\n    \n    // Assign names to sections\n    for (let i = 0; i < sections.length; i++) {\n        sections[i].name = sectionNames[sections[i].name] || \"\";\n    }\n    \n    // Helper to read 64-bit value from buffer\n    function readUInt64LE(buf, offset) {\n        const low = buf.readUInt32LE(offset);\n        const high = buf.readUInt32LE(offset + 4);\n        return high * 2**32 + low;\n    }\n    \n    // Helper to read 32-bit value from buffer\n    function readUInt32LE(buf, offset) {\n        return buf.readUInt32LE(offset);\n    }\n    \n    // Extract values from sections that contain data\n    function extractSectionValues(section, addressSize = 64) {\n        if (section.size === 0) return;\n        \n        const addr = section.addr;\n        const offset = section.offset;\n        const size = section.size;\n        \n        if (addressSize === 64) {\n            for (let i = 0; i + 8 <= size; i += 8) {\n                const value = readUInt64LE(buffer, offset + i);\n                const address = addr + i;\n                if (address > 0) {\n                    memory[address.toString()] = value;\n                }\n            }\n        } else {\n            for (let i = 0; i + 4 <= size; i += 4) {\n                const value = readUInt32LE(buffer, offset + i);\n                const address = addr + i;\n                if (address > 0) {\n                    memory[address.toString()] = value;\n                }\n            }\n        }\n    }\n    \n    // Extract from data-containing sections\n    for (const section of sections) {\n        // Extract from sections with data (PROGBITS type = 1)\n        if (section.type === 1 && section.size > 0) {\n            // For sections with 8-byte alignment, extract 64-bit values\n            if (section.addr % 8 === 0 || section.name === '.dynamic' || \n                section.name === '.got' || section.name === '.init_array' || \n                section.name === '.fini_array' || section.name === '.dynsym') {\n                extractSectionValues(section, 64);\n            } else {\n                // For other sections, extract 8-bit bytes\n                for (let i = 0; i < section.size; i++) {\n                    const value = buffer[section.offset + i];\n                    const address = section.addr + i;\n                    if (address > 0) {\n                        memory[address.toString()] = value;\n                    }\n                }\n            }\n        }\n    }\n    \n    // Also extract raw bytes from the entire file at their file offsets\n    // (treating file offset as address for raw binary data)\n    for (let i = 0; i < buffer.length; i += 8) {\n        if (i + 8 <= buffer.length) {\n            const value = readUInt64LE(buffer, i);\n            // Only include addresses that correspond to actual section data\n            const inSection = sections.some(s => i >= s.offset && i < s.offset + s.size);\n            if (inSection) {\n                const addrStr = i.toString();\n                if (!(addrStr in memory)) {\n                    memory[addrStr] = value;\n                }\n            }\n        }\n    }\n    \n    return memory;\n}\n\n// Main execution\nconst filePath = process.argv[2];\nif (!filePath) {\n    console.error(\"Usage: node extract.js <binary_file>\");\n    process.exit(1);\n}\n\nconst memory = extractMemoryValues(filePath);\nconsole.log(JSON.stringify(memory));","filePath":"/app/extract.js"}