{"command":"node -e \"\nconst fs = require('fs');\nconst buf = fs.readFileSync('/app/a.out');\n\n// Check what 4194304 would map to\n// 4194304 = 0x400000\n// If we're reading from file offset 0, we need to find where 0x400000 maps\n\n// Let's see what the first few 32-bit values are at file offset 0\nfor (let i = 0; i < 64; i += 4) {\n    const val = buf.readUInt32LE(i);\n    console.log('File offset ' + i + ' (0x' + i.toString(16) + '): ' + val);\n}\n\""}