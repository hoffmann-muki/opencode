{"command":"node -e \"\nconst fs = require('fs');\nconst buf = fs.readFileSync('/app/a.out');\n\n// .text section starts at file offset 0x1060 (4192) with virtual address 0x1060\n// Let's read 32-bit values from .text section\nconst textOffset = 0x1060;\nconst textSize = 0x107;\n\nconsole.log('Reading .text section:');\nfor (let i = 0; i < textSize; i += 4) {\n    if (i + 4 <= textSize) {\n        const val = buf.readUInt32LE(textOffset + i);\n        const addr = 0x1060 + i;\n        console.log('Address ' + addr + ' (0x' + addr.toString(16) + '): ' + val);\n    }\n}\n\""}