{"content":"const fs = require('fs');\n\nfunction extractMemoryValues(filePath) {\n    const buffer = fs.readFileSync(filePath);\n    const memory = {};\n    \n    // Extract all 32-bit values from the binary file\n    // Using file offset as the memory address (with base 0x400000 for typical x86-64 layout)\n    const baseAddress = 0x400000;\n    \n    for (let i = 0; i + 4 <= buffer.length; i += 4) {\n        const value = buffer.readUInt32LE(i);\n        const address = baseAddress + i;\n        memory[address.toString()] = value;\n    }\n    \n    // Handle remaining bytes (less than 4 bytes at the end)\n    const remainingStart = Math.floor(buffer.length / 4) * 4;\n    for (let i = remainingStart; i < buffer.length; i++) {\n        const value = buffer[i];\n        const address = baseAddress + i;\n        memory[address.toString()] = value;\n    }\n    \n    return memory;\n}\n\n// Main execution\nconst filePath = process.argv[2];\nif (!filePath) {\n    console.error(\"Usage: node extract.js <binary_file>\");\n    process.exit(1);\n}\n\nconst memory = extractMemoryValues(filePath);\nconsole.log(JSON.stringify(memory));","filePath":"/app/extract.js"}