{"content":"const fs = require('fs');\n\nfunction extractMemoryValues(filePath) {\n    const buffer = fs.readFileSync(filePath);\n    const memory = {};\n    \n    // Parse ELF header\n    const is64bit = buffer[4] === 2; // 64-bit\n    const littleEndian = buffer[5] === 1; // Little endian\n    \n    function readUInt64(offset) {\n        if (littleEndian) {\n            return buffer.readUInt32LE(offset) + buffer.readUInt32LE(offset + 4) * 2**32;\n        } else {\n            return buffer.readUInt32BE(offset) * 2**32 + buffer.readUInt32BE(offset + 4);\n        }\n    }\n    \n    function readUInt32(offset) {\n        if (littleEndian) {\n            return buffer.readUInt32LE(offset);\n        } else {\n            return buffer.readUInt32BE(offset);\n        }\n    }\n    \n    function readUInt16(offset) {\n        if (littleEndian) {\n            return buffer.readUInt16LE(offset);\n        } else {\n            return buffer.readUInt16BE(offset);\n        }\n    }\n    \n    const e_phoff = is64bit ? readUInt64(0x20) : readUInt32(0x1c);\n    const e_shoff = is64bit ? readUInt64(0x28) : readUInt32(0x24);\n    const e_phentsize = readUInt16(0x36);\n    const e_phnum = readUInt16(0x38);\n    const e_shentsize = readUInt16(0x3a);\n    const e_shnum = readUInt16(0x3c);\n    const e_shstrndx = readUInt16(0x3e);\n    \n    // Parse section headers\n    const sections = [];\n    for (let i = 0; i < e_shnum; i++) {\n        const offset = e_shoff + i * e_shentsize;\n        const sh_name = readUInt32(offset);\n        const sh_type = readUInt32(offset + 4);\n        const sh_flags = is64bit ? readUInt64(offset + 8) : readUInt64(offset + 8);\n        const sh_addr = is64bit ? readUInt64(offset + 16) : readUInt64(offset + 16);\n        const sh_offset = is64bit ? readUInt64(offset + 24) : readUInt64(offset + 24);\n        const sh_size = is64bit ? readUInt64(offset + 32) : readUInt64(offset + 32);\n        const sh_link = readUInt32(offset + 40);\n        const sh_info = readUInt32(offset + 44);\n        const sh_addralign = is64bit ? readUInt64(offset + 48) : readUInt64(offset + 48);\n        const sh_entsize = is64bit ? readUInt64(offset + 56) : readUInt64(offset + 56);\n        \n        sections.push({\n            nameIdx: sh_name,\n            type: sh_type,\n            addr: sh_addr,\n            offset: sh_offset,\n            size: sh_size,\n            link: sh_link,\n            addralign: sh_addralign\n        });\n    }\n    \n    // Get section name string table\n    const shstrtab = sections[e_shstrndx];\n    const sectionNames = [];\n    let currentName = \"\";\n    for (let i = shstrtab.offset; i < shstrtab.offset + shstrtab.size; i++) {\n        if (buffer[i] === 0) {\n            sectionNames.push(currentName);\n            currentName = \"\";\n        } else {\n            currentName += String.fromCharCode(buffer[i]);\n        }\n    }\n    \n    // Assign names to sections\n    for (let i = 0; i < sections.length; i++) {\n        sections[i].name = sectionNames[sections[i].nameIdx] || \"\";\n    }\n    \n    // Helper to read 32-bit value from buffer at file offset\n    function readUInt32LEFromFile(buf, offset) {\n        return buf.readUInt32LE(offset);\n    }\n    \n    // Helper to read 64-bit value from buffer at file offset\n    function readUInt64LEFromFile(buf, offset) {\n        const low = buf.readUInt32LE(offset);\n        const high = buf.readUInt32LE(offset + 4);\n        return high * 2**32 + low;\n    }\n    \n    // Extract values from sections that contain data\n    // We extract 32-bit values from most sections\n    for (const section of sections) {\n        if (section.size === 0 || section.addr === 0) continue;\n        \n        // For most sections, extract 32-bit values\n        // But for sections with 8-byte alignment, extract 64-bit values\n        const align = section.addralign || 8;\n        \n        if (align >= 8 && section.name !== '.text' && section.name !== '.init' && \n            section.name !== '.fini' && section.name !== '.rodata' && \n            section.name !== '.eh_frame_hdr' && section.name !== '.eh_frame' &&\n            section.name !== '.interp' && section.name !== '.note.gnu.property' &&\n            section.name !== '.note.gnu.build-id' && section.name !== '.note.ABI-tag' &&\n            section.name !== '.gnu.hash' && section.name !== '.dynsym' &&\n            section.name !== '.dynstr' && section.name !== '.gnu.version' &&\n            section.name !== '.gnu.version_r' && section.name !== '.rela.dyn' &&\n            section.name !== '.rela.plt' && section.name !== '.comment') {\n            // Extract 64-bit values\n            for (let i = 0; i + 8 <= section.size; i += 8) {\n                const value = readUInt64LEFromFile(buffer, section.offset + i);\n                const address = section.addr + i;\n                if (address > 0) {\n                    memory[address.toString()] = value;\n                }\n            }\n        } else {\n            // Extract 32-bit values\n            for (let i = 0; i + 4 <= section.size; i += 4) {\n                const value = readUInt32LEFromFile(buffer, section.offset + i);\n                const address = section.addr + i;\n                if (address > 0) {\n                    memory[address.toString()] = value;\n                }\n            }\n            // Handle remaining bytes\n            for (let i = Math.floor(section.size / 4) * 4; i < section.size; i++) {\n                const value = buffer[section.offset + i];\n                const address = section.addr + i;\n                if (address > 0) {\n                    memory[address.toString()] = value;\n                }\n            }\n        }\n    }\n    \n    return memory;\n}\n\n// Main execution\nconst filePath = process.argv[2];\nif (!filePath) {\n    console.error(\"Usage: node extract.js <binary_file>\");\n    process.exit(1);\n}\n\nconst memory = extractMemoryValues(filePath);\nconsole.log(JSON.stringify(memory));","filePath":"/app/extract.js"}